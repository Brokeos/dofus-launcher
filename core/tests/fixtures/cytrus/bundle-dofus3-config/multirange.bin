
--00000000003734884208
Content-Type: application/octet-stream
Content-Range: bytes 0-2350/7879

maxInstances: true

arguments:
{% block arguments %}{% endblock arguments %}
  - "{{ game.settings.directxVersion }}"
  
fragments:
  - "win32_x64"
  - "start-script"
{% block fragments %}{% endblock fragments %}

settings:
  {% block settings %}{% endblock settings %}
  - name: "directxVersion"
    default: ""
    label:
      en: "DirectX Version"
      fr: "Version de DirectX"
      de: "DirectX-Version"
      es: "Versión de DirectX"
      pt: "Versão do DirectX"
    type: select
    description:
      en: "DirectX 12 may not be compatible on some older machines or those equipped with graphics cards that do not fully support the latest technologies. If you experience crashes at startup or graphical issues, you may need to switch back to DirectX 11."
      fr: "Sur certaines machines plus anciennes ou équipées d'une carte graphique ne prenant pas pleinement en charge les dernières technologies, DirectX 12 peut ne pas être compatible. Si vous rencontrez des plantages au démarrage ou des problèmes graphiques, il peut être nécessaire de revenir à DirectX 11."
      de: "Auf einigen älteren Computern oder Computern, die eine veraltete Grafikkarte nutzen, ist DirectX 12 möglicherweise nicht kompatibel. Falls beim Start Abstürze oder Grafikprobleme auftreten, ist es möglicherweise erforderlich, wieder auf die Vorgängerversion (Direct X 11) umzusteigen."
      es: "DirectX 12 puede no ser compatible en algunos equipos más antiguos o en aquellos con tarjetas gráficas que no admiten completamente las tecnologías más recientes. Si experimentas bloqueos al iniciar o problemas gráficos, puede que necesites volver a DirectX 11."
      pt: "Em computadores mais antigos ou equipados com uma placa de vídeo que não utiliza as tecnologias mais recentes, o DirectX 12 pode não ser compatível. Caso encontre travamentos na inicialização ou problemas gráficos, pode ser necessário voltar para o DirectX 11."
    options:
      - label:
          en: "DirectX 12"
          fr: "DirectX 12"
          de: "DirectX 12"
          es: "DirectX 12"
          pt: "DirectX 12"
        value: ""
      - label:
          en: "DirectX 11"
          fr: "DirectX 11"
          de: "DirectX 11"
          es: "DirectX 11"
          pt: "DirectX 11"
        value: "-force-d3d11"
{% block quality %}{% endblock quality %}
--00000000003734884208
Content-Type: application/octet-stream
Content-Range: bytes 2351-7878/7879

{% extends "zaap-" + os.platform + ".yml" %}

{% block arguments %}
  - "--port"
  - "{{ env.ZAAP_PORT }}"
  - "--gameName"
  - "{{ env.ZAAP_GAME }}"
  - "--gameRelease"
  - "{{ env.ZAAP_RELEASE }}"
  - "--instanceId"
  - "{{ env.ZAAP_INSTANCE_ID }}"
  - "--hash"
  - "{{ env.ZAAP_HASH }}"
  - "--canLogin"
  - "{{ env.ZAAP_CAN_AUTH }}"
  - "--langCode"
  - "{{ game.settings.language }}"
  - "--autoConnectType"
  - "{{ game.settings.autoConnectType }}"
  - "--connectionPort"
  - "{{ game.settings.connectionPort }}"
{% if game.settings.hdReady %}
  - "--hdReady"
{% endif %}
{% if game.settings.4kReady %}
  - "--4kReady"
{% endif %}
{% endblock arguments %}

{% block fragments %}
  - "bones"
  - "skins"
  - "audio"
  - "data"
  - "i18n"
  - "picto"
  - "map_common"
{% if game.settings.hdReady %}
  - "map_textures_2x"
{% endif %}
{% if game.settings.4kReady %}
  - "map_textures_4x"
{% endif %}
  - "start-script"
{% endblock fragments %}

{% block settings %}
  - name: "language"
    default: "{{ zaap.LANGUAGE }}"
    label: 
      fr: "Langue"
      en: "Language"
      de: "Sprache"
      es: "Lengua"
      pt: "Idioma"
    description:
      fr: "Langue utilisée dans le jeu Dofus"
      en: "Language used in the game Dofus"
      de: "Verwendete Sprache im Spiel Dofus"
      es: "Idioma utilizado en el juego Dofus"
      pt: "Idioma utilizado no jogo Dofus"
    type: select
    options: 
      - label: "Francais"
        value: "fr"

      - label: "English"
        value: "en"

      - label: "Deutsch"
        value: "de"

      - label: "Español"
        value: "es"

      - label: "Português"
        value: "pt"
  - name: "autoConnectType"
    default: 1
    label:
      en: "Connection"
      fr: "Connexion"
      de: "Verbindungsaufbau"
      es: "Conexión"
      pt: "Conexão"
    description:
      en: "Log in directly ..."
      fr: "Se connecter directement ..."
      de: "Sich direkt einloggen ..."
      es: "Conectarse directamente ..."
      pt: "Conectar-se diretamente ..."
    type: select
    options: 
      - label:
          en: "... to server choice"
          fr: "... au choix de serveur"
          de: "... in die Serverwahl"
          es: "... a la elección de servidor"
          pt: "... à escolha do servidor"
        value: 0
        
      - label:
          en: "... to character choice"
          fr: "... au choix de personnage"
          de: "... in die Charakterwahl"
          es: "... a la elección de personaje"
          pt: "... à escolha do personagem"
        value: 1
        
      - label:
          en: "... to the game"
          fr: "... au jeu"
          de: "... in das Spiel"
          es: "... al juego"
          pt: "... ao jogo"
        value: 2
  - name: "connectionPort"
    default: "5555"
    label:
      en: "Connection port"
      fr: "Port de connexion"
      de: "Einwahlport"
      es: "Puerto de conexión"
      pt: "Porta de conexão"
    type: select
    options:
      - label:
          en: "5555"
          fr: "5555"
          de: "5555"
          es: "5555"
          pt: "5555"
        value: "5555"

      - label:
          en: "443"
          fr: "443"
          de: "443"
          es: "443"
          pt: "443"
        value: "443"
{% endblock settings %}
{% block quality %}
  - name: "hdReady"
    default: false
    label:
      en: "Download the DOFUS HD Pack (Experimental)"
      fr: "Télécharger Dofus HD Pack (Experimental)"
      de: "Download the DOFUS HD Pack (Experimental)"
      es: "Descargar Pack Dofus HD (Experimental)"
      pt: "Baixar Dofus HD Pack (Experimental)"
    description:
      en: "Download a pack of additional HD textures for maps. Appropriate for mid-range configurations, preferably with a Full HD screen."
      fr: "Télécharge un pack de textures HD additionnel pour les maps, convient pour les configurations de milieu de gamme, avec de préférence un écran Full HD."
      de: "Download a pack of additional HD textures for maps. Appropriate for mid-range configurations, preferably with a Full HD screen."
      es: "Descarga un pack de texturas HD adicional para los mapas, conviene para las configuraciones de gama media, con una pantalla Full HD preferentemente."
      pt: "Baixe um pacote de texturas HD adicional para os mapas, conveniente para configurações médias, de preferência em uma tela Full HD."
    type: checkbox
  - name: "4kReady"
    default: false
    label:
      en: "Download the DOFUS 4K Pack (Experimental)"
      fr: "Télécharger Dofus 4K Pack (Experimental)"
      de: "Download the DOFUS 4K Pack (Experimental)"
      es: "Descargar Pack Dofus 4K (Experimental)"
      pt: "Baixar Dofus 4K Pack (Experimental)"
    description:
      en: "Download a pack of additional 4K textures for maps. Appropriate for the latest configurations, preferably with a 4K screen."
      fr: "Télécharge un pack de textures 4K additionnel pour les maps, convient pour les configurations dernière génération, avec de préférence un écran 4K."
      de: "Download a pack of additional 4K textures for maps. Appropriate for the latest configurations, preferably with a 4K screen."
      es: "Descarga un pack de texturas 4K adicional para los mapas, conviene para las configuraciones de última generación, con una pantalla 4K preferentemente."
      pt: "Baixe um pacote de texturas 4K adicional para os mapas, conveniente para configurações de última geração, de preferência em uma tela 4K."
    type: checkbox
{% endblock quality %}

--00000000003734884208--
